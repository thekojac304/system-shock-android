# TEMPORARY: generate diagnostic copies; never edit the pinned dependency trees.
# Fail closed if the expected source anchors change.
function(trace_replace before after)
    string(FIND "${trace_source}" "${before}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "AUDLIFE source anchor missing: ${before}")
    endif()
    string(REPLACE "${before}" "${after}" trace_source "${trace_source}")
    set(trace_source "${trace_source}" PARENT_SCOPE)
endfunction()
function(trace_install target original output)
    get_target_property(sources ${target} SOURCES)
    get_target_property(root ${target} SOURCE_DIR)
    set(replaced FALSE)
    set(updated "")
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${root}")
        if(absolute STREQUAL original)
            list(APPEND updated "${output}")
            set(replaced TRUE)
        else()
            # Preserve resolution of relative sources when setting from this directory.
            list(APPEND updated "${absolute}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "AUDLIFE target source missing: ${original}")
    endif()
    file(WRITE "${output}" "${trace_source}")
    set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
    get_filename_component(source_dir "${original}" DIRECTORY)
    set_source_files_properties("${output}" TARGET_DIRECTORY ${target}
        PROPERTIES INCLUDE_DIRECTORIES "${source_dir};${CMAKE_CURRENT_LIST_DIR}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
endfunction()

