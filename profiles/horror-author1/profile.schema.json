{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:shockolate:horror-author1:profile:1",
  "title":"Neutral horror presentation profile, diagnostic version 1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","generator_version","origin","level_id","baseline_signature","rules_signature","texture_properties_signature","object_properties_signature","units","defaults","regions","lights","material_rules","dynamic_overrides","diagnostics"],
  "properties":{
    "schema_version":{"const":1}, "generator_version":{"type":"string"},
    "origin":{"$ref":"#/$defs/origin"}, "level_id":{"enum":[0,1,2,3,4,5,6,7,9]},
    "baseline_signature":{"$ref":"#/$defs/hash"}, "rules_signature":{"$ref":"#/$defs/hash"},
    "texture_properties_signature":{"$ref":"#/$defs/hash"},
    "object_properties_signature":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "source_archive_sha256":{"$ref":"#/$defs/hash"},
    "units":{"type":"object","required":["position","rgb","intensity","density"],"additionalProperties":{"type":"string"}},
    "defaults":{"type":"object","additionalProperties":false,
      "required":["archetype","ambient_rgb","ambient_intensity","darkness_response","fog","grading"],
      "properties":{
        "archetype":{"type":"string"},"ambient_rgb":{"$ref":"#/$defs/rgb"},
        "ambient_intensity":{"type":"number","minimum":0,"maximum":1},
        "darkness_response":{"type":"object","additionalProperties":false,
          "required":["input","normalized_white","normalized_black","exponent","floor"],
          "properties":{"input":{"const":"live_original_scalar_darkness"},"normalized_white":{"const":0},
            "normalized_black":{"const":16},"exponent":{"type":"number","minimum":1,"maximum":4},
            "floor":{"type":"number","minimum":0,"maximum":0.1}}},
        "fog":{"$ref":"#/$defs/fog"},"grading":{"$ref":"#/$defs/grading"}}},
    "regions":{"type":"array","items":{"$ref":"#/$defs/region"},"maxItems":4096},
    "lights":{"type":"array","items":{"$ref":"#/$defs/light"},"maxItems":4096},
    "material_rules":{"type":"array","items":{"$ref":"#/$defs/material"}},
    "dynamic_overrides":{"type":"array","items":{"$ref":"#/$defs/dynamic"}},
    "diagnostics":{"type":"object","description":"Non-runtime evidence: original tiles, objects, event parameters, candidates, graph, warnings and summary."}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "origin":{"enum":["generated","manual"]},
    "rgb":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":0,"maximum":1}},
    "xyz":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":-128,"maximum":128}},
    "tiles":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":4095}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "grading":{"type":"object","additionalProperties":false,"required":["saturation","exposure"],
      "properties":{"saturation":{"type":"number","minimum":0,"maximum":2},"exposure":{"type":"number","minimum":-2,"maximum":2}}},
    "fog":{"type":"object","additionalProperties":false,
      "required":["enabled","rgb","density","model","start","end","height_influence","state_channel"],
      "properties":{"enabled":{"type":"boolean"},"rgb":{"$ref":"#/$defs/rgb"},
        "density":{"type":"number","minimum":0,"maximum":0.2},"model":{"enum":["exp","linear"]},
        "start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},
        "height_influence":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,
          "required":["base_z","falloff"],"properties":{"base_z":{"type":"number"},"falloff":{"type":"number","minimum":0}}}]},
        "state_channel":{"type":["string","null"]},"suggestion":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"}}},
    "region":{"type":"object","additionalProperties":false,
      "required":["id","name","origin","priority","tiles","height_bounds","classification","confidence","bounds","ambient_override","fog_override","grading_override","statistics"],
      "properties":{"id":{"type":"string"},"name":{"type":"string"},"origin":{"$ref":"#/$defs/origin"},
        "priority":{"type":"integer"},"tiles":{"$ref":"#/$defs/tiles"},
        "height_bounds":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
        "classification":{"type":"string"},"confidence":{"$ref":"#/$defs/confidence"},
        "bounds":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}},
        "ambient_override":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,
          "required":["rgb","intensity"],"properties":{"rgb":{"$ref":"#/$defs/rgb"},"intensity":{"type":"number","minimum":0,"maximum":1}}}]},
        "fog_override":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/fog"}]},
        "grading_override":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/grading"}]},"statistics":{"type":"object"}}},
    "predicate":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","object_id"],"properties":{
        "kind":{"const":"object_active"},"object_id":{"type":"integer","minimum":1,"maximum":871}}},
      {"type":"object","additionalProperties":false,"required":["kind","index","value"],"properties":{
        "kind":{"const":"questbit_equals"},"index":{"type":"integer","minimum":0,"maximum":511},"value":{"type":"boolean"}}},
      {"type":"object","additionalProperties":false,"required":["kind","index","value"],"properties":{
        "kind":{"const":"questvar_equals"},"index":{"type":"integer","minimum":0,"maximum":63},"value":{"type":"integer"}}},
      {"type":"object","additionalProperties":false,"required":["kind","object_id","mask","value"],"properties":{
        "kind":{"const":"trap_p2_mask_equals"},"object_id":{"type":"integer","minimum":1,"maximum":871},
        "mask":{"type":"integer","minimum":0,"maximum":4294967295},"value":{"type":"integer","minimum":0,"maximum":4294967295}}}
    ]},
    "light":{"type":"object","additionalProperties":false,
      "required":["id","origin","position","rgb","intensity","radius","falloff","receiver_regions","receiver_tiles","state_condition","source_resource_id","source_object_id","confidence","parameter_confidence"],
      "properties":{"id":{"type":"string"},"origin":{"$ref":"#/$defs/origin"},"position":{"$ref":"#/$defs/xyz"},
        "rgb":{"$ref":"#/$defs/rgb"},"intensity":{"type":"number","minimum":0,"maximum":8},
        "radius":{"type":"number","exclusiveMinimum":0,"maximum":16},"falloff":{"const":"squared_linear"},
        "receiver_regions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "receiver_tiles":{"$ref":"#/$defs/tiles"},
        "state_condition":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/predicate"}]},
        "source_resource_id":{"type":["integer","null"],"minimum":0,"maximum":362},
        "source_object_id":{"type":["integer","null"],"minimum":1,"maximum":871},
        "confidence":{"$ref":"#/$defs/confidence"},"parameter_confidence":{"$ref":"#/$defs/confidence"}}},
    "material":{"type":"object","additionalProperties":false,
      "required":["id","origin","resource_id","family_id","animation_group","animation_position","classification","emissive","emissive_indices","emissive_gain","grading_policy","local_light_policy","surface_emission","special_handling"],
      "properties":{"id":{"type":"string"},"origin":{"$ref":"#/$defs/origin"},
        "resource_id":{"type":"integer","minimum":0,"maximum":362},"family_id":{"type":"integer","minimum":0,"maximum":255},
        "animation_group":{"type":"integer","minimum":0,"maximum":255},"animation_position":{"type":"integer","minimum":0,"maximum":255},
        "classification":{"type":"string"},"emissive":{"type":"boolean"},"emissive_indices":{"type":"array","uniqueItems":true,"maxItems":256,"items":{"type":"integer","minimum":0,"maximum":255}},"emissive_gain":{"type":"number","minimum":0,"maximum":2},
        "grading_policy":{"const":"preserve_original_art"},"local_light_policy":{"enum":["none","surface_aware"]},
        "surface_emission":{"type":"object","additionalProperties":false,"required":["ceiling","floor","wall"],
          "properties":{"ceiling":{"enum":["emissive_only","emits_low","emits_normal","review_only"]},
            "floor":{"enum":["emissive_only","emits_low","emits_normal","review_only"]},
            "wall":{"enum":["emissive_only","emits_low","emits_normal","review_only"]}}},
        "special_handling":{"type":"string"}}},
    "dynamic":{"type":"object","additionalProperties":false,"required":["id","origin","predicate","targets","values","transition"],
      "properties":{"id":{"type":"string"},"origin":{"$ref":"#/$defs/origin"},"predicate":{"$ref":"#/$defs/predicate"},
        "targets":{"type":"array","minItems":1,"items":{"type":"string"}},
        "values":{"type":"object","additionalProperties":false,"properties":{"ambient_rgb":{"$ref":"#/$defs/rgb"},
          "ambient_intensity":{"type":"number","minimum":0,"maximum":1},"light_intensity":{"type":"number","minimum":0,"maximum":8},"fog":{"$ref":"#/$defs/fog"}}},
        "transition":{"type":"object","additionalProperties":false,"required":["seconds","curve"],"properties":{
          "seconds":{"type":"number","minimum":0,"maximum":60},"curve":{"enum":["step","linear","smoothstep"]}}}}}
  }
}
